[
  // OPTION + HJKL FOR ARROWS
  {
    "description": "use option + hjkl as arrows",
    "manipulators": [
      {
        "from": {
          "key_code": "h",
          "modifiers": {
            "mandatory": ["option"],
            "optional": ["shift"],
          },
        },
        "to": [{ "key_code": "left_arrow" }],
        "type": "basic",
        "conditions": [
          {
            "type": "frontmost_application_unless",
            "bundle_identifiers": ["com.moonlight-stream.Moonlight"],
          },
        ],
      },
      {
        "from": {
          "key_code": "j",
          "modifiers": {
            "mandatory": ["option"],
            "optional": ["shift"],
          },
        },
        "to": [{ "key_code": "down_arrow" }],
        "type": "basic",
        "conditions": [
          {
            "type": "frontmost_application_unless",
            "bundle_identifiers": ["com.moonlight-stream.Moonlight"],
          },
        ],
      },
      {
        "from": {
          "key_code": "k",
          "modifiers": {
            "mandatory": ["option"],
            "optional": ["shift"],
          },
        },
        "to": [{ "key_code": "up_arrow" }],
        "type": "basic",
        "conditions": [
          {
            "type": "frontmost_application_unless",
            "bundle_identifiers": ["com.moonlight-stream.Moonlight"],
          },
        ],
      },
      {
        "from": {
          "key_code": "l",
          "modifiers": {
            "mandatory": ["option"],
            "optional": ["shift"],
          },
        },
        "to": [{ "key_code": "right_arrow" }],
        "type": "basic",
        "conditions": [
          {
            "type": "frontmost_application_unless",
            "bundle_identifiers": ["com.moonlight-stream.Moonlight"],
          },
        ],
      },
      {
        "type": "basic",
        "from": {
          "key_code": "h",
          "modifiers": {
            "mandatory": ["control", "option"],
            "optional": ["shift"],
          },
        },
        "to": [{ "key_code": "left_arrow", "modifiers": ["option"] }],
        "conditions": [
          {
            "type": "variable_if",
            "name": "physical_left_cmd_held",
            "value": 0,
          },
          {
            "type": "variable_if",
            "name": "physical_right_cmd_held",
            "value": 0,
          },
          {
            "type": "frontmost_application_unless",
            "bundle_identifiers": ["com.moonlight-stream.Moonlight"],
