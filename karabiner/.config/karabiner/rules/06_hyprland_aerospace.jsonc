[
  // HYPRLAND LIKE KEYBINDS (AEROSPACE + OTHER)
  {
    "description": "Command as mainMod for hyprland like keybinds",
    "manipulators": [
      // Workspaces manipulation
      {
        "type": "basic",
        "from": {
          "key_code": "1",
          "modifiers": {
            "mandatory": ["control"],
            "optional": ["shift"],
          },
        },
        "to": [{ "key_code": "1", "modifiers": ["command"] }],
        "conditions": [
          {
            "type": "variable_if",
            "name": "physical_left_cmd_held",
            "value": 1,
          },
          {
            "type": "frontmost_application_unless",
            "bundle_identifiers": ["com.moonlight-stream.Moonlight"],
          },
        ],
      },
      {
        "type": "basic",
        "from": {
          "key_code": "1",
          "modifiers": {
            "mandatory": ["control"],
            "optional": ["shift"],
