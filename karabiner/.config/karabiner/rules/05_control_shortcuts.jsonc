[
  // SHORTCUTS TO EXECUTE ON CONTROL KEY
  {
    "description": "Make those command shortcuts work on control",
    "manipulators": [
      // ctrl + n/p -> down/up
      {
        "type": "basic",
        "from": {
          "key_code": "n",
          "modifiers": {
            "mandatory": ["control"],
          },
        },
        "to": [{ "key_code": "down_arrow" }],
        "conditions": [
          {
            "type": "variable_if",
            "name": "physical_left_cmd_held",
            "value": 0,
          },
          {
            "type": "variable_if",
            "name": "physical_right_cmd_held",
            "value": 0,
          },
          {
            "type": "frontmost_application_unless",
            "bundle_identifiers": ["com.moonlight-stream.Moonlight"],
          },
        ],
      },
      {
        "type": "basic",
        "from": {
          "key_code": "p",
          "modifiers": { "mandatory": ["control"] },
        },
        "to": [{ "key_code": "up_arrow" }],
        "conditions": [
          {
            "type": "variable_if",
            "name": "physical_left_cmd_held",
            "value": 0,
          },
          {
            "type": "variable_if",
            "name": "physical_right_cmd_held",
            "value": 0,
          },
          {
            "type": "frontmost_application_unless",
            "bundle_identifiers": ["com.moonlight-stream.Moonlight"],
          },
        ],
      },
      // Control +/-/0 zoom manipulation
      {
        "type": "basic",
        "from": {
          "key_code": "equal_sign",
          "modifiers": { "mandatory": ["control"] },
        },
        "to": [
          {
            "key_code": "equal_sign",
            "modifiers": ["command"],
          },
        ],
        "conditions": [
          {
            "type": "variable_if",
            "name": "physical_left_cmd_held",
            "value": 0,
          },
          {
            "type": "variable_if",
            "name": "physical_right_cmd_held",
            "value": 0,
          },
          {
            "type": "frontmost_application_unless",
            "bundle_identifiers": ["com.moonlight-stream.Moonlight"],
          },
        ],
      },
      {
        "type": "basic",
        "from": {
          "key_code": "hyphen",
          "modifiers": { "mandatory": ["control"] },
        },
        "to": [
          {
